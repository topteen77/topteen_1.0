# HTTPS (:443) - only active when /etc/nginx/ssl/{cert.pem,key.pem} exist.
# 25-ssl-optional.sh removes the rendered 10-https.conf if certs are missing,
# so the LB still starts cleanly on HTTP-only (dev / pre-certificate) hosts.
server {
    listen 443 ssl;
    http2 on;
    server_name ${SERVER_NAMES};
    client_max_body_size ${CLIENT_MAX_BODY_SIZE};

    ssl_certificate     /etc/nginx/ssl/cert.pem;
    ssl_certificate_key /etc/nginx/ssl/key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1h;

    access_log /var/log/nginx/access.log;
    error_log  /var/log/nginx/error.log warn;

    location /static/ {
        alias /var/www/html/static/;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    location / {
        set $upstream "${APP_UPSTREAM}:${APP_UPSTREAM_PORT}";
        proxy_pass http://$upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 60s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
        proxy_next_upstream error timeout http_502 http_503 http_504;
    }
}
