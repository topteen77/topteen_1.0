# HTTP (:80) - rendered from env: SERVER_NAMES, APP_UPSTREAM(:PORT), CLIENT_MAX_BODY_SIZE
# Serves the app + Let's Encrypt ACME challenge. HTTPS is in 10-https.conf
# (kept only when SSL certs are present - see 25-ssl-optional.sh).
server {
    listen 80;
    server_name ${SERVER_NAMES};
    client_max_body_size ${CLIENT_MAX_BODY_SIZE};

    access_log /var/log/nginx/access.log;
    error_log  /var/log/nginx/error.log warn;

    # Let's Encrypt webroot challenge (certbot renew --webroot -w /var/www/certbot)
    location /.well-known/acme-challenge/ {
        root /var/www/acme;
        allow all;
    }

    location /static/ {
        alias /var/www/html/static/;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # /media/ is proxied to the app (S3 proxy mode) rather than served from disk.
    location / {
        set $upstream "${APP_UPSTREAM}:${APP_UPSTREAM_PORT}";
        proxy_pass http://$upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 60s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
        proxy_next_upstream error timeout http_502 http_503 http_504;
    }
}
