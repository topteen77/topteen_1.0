# =============================================================================
# TopTeen deployment env - STAGING
# Copy to staging.env and fill real values:  cp staging.env.example staging.env
# staging.env is git-ignored (never commit real secrets).
#
# Staging mirrors production but with its own image tag, container names,
# ports, network and volumes so it can even run on the SAME host safely.
# =============================================================================

# --------------------------------------------------------------------------
# IDENTITY -> containers: topteen-staging-base-nginx-1, topteen-staging-app-web-1 ...
#            images:     developertopteen/demotopteen:staging
# --------------------------------------------------------------------------
PROJECT_NAME=topteen
ENVIRONMENT=staging

# --------------------------------------------------------------------------
# IMAGES
# --------------------------------------------------------------------------
APP_IMAGE=developertopteen/demotopteen
APP_IMAGE_TAG=staging
NGINX_IMAGE=developertopteen/demotopteen-nginx
NGINX_IMAGE_TAG=staging
DOCKER_PUSH_REGISTRY=

# --------------------------------------------------------------------------
# SCALE / PERFORMANCE  (smaller than production)
# --------------------------------------------------------------------------
WEB_REPLICAS=2
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
CELERY_CONCURRENCY=2

# --------------------------------------------------------------------------
# PUBLISHED PORTS - non-standard so staging can co-exist with production /
# other projects on the same host.
# --------------------------------------------------------------------------
APP_PORT=8005
HTTPS_PORT=8443

SERVER_NAMES=demo.topteen.in staging.topteen.in localhost

# --------------------------------------------------------------------------
# BASE STACK PROFILES - staging often runs its own DB + search locally
# --------------------------------------------------------------------------
BASE_PROFILES=local-db,search

# --------------------------------------------------------------------------
# HOST PATHS
# --------------------------------------------------------------------------
LOG_PATH=/home/ubuntu/topteen-staging/logs
SSL_CERT_PATH=/home/ubuntu/topteen-staging/ssl
CERTBOT_WEBROOT=/home/ubuntu/topteen-staging/certbot-webroot
CERTBOT_CONF_PATH=/home/ubuntu/topteen-staging/certbot-conf
CERTBOT_EMAIL=admin@topteen.in

# MariaDB container data (used when local-db profile is on)
DB_DATA_PATH=/home/ubuntu/topteen-staging/dbdata
ES_DATA_PATH=/home/ubuntu/topteen-staging/esdata

APP_ENV_FILE=../../.env

# =============================================================================
# DJANGO OVERRIDES FOR THIS ENVIRONMENT
# =============================================================================
DEBUG=False
DJANGO_ENVIRONMENT=staging

ENABLE_REDIS=True
REDIS_HOST=redis
REDIS_PORT=6379
ENABLE_CELERY=True
ENABLE_ELASTICSEARCH=True
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200

USE_HTTPS=False

# Local DB container (matches local-db profile). MariaDB creds for the container:
DB_HOST=mariadb
DB_PORT=3306
DB_NAME=topteen_staging
DB_USER=topteen
DB_PASSWORD=change-me-staging
MYSQL_ROOT_PASSWORD=change-me-root

ALLOWED_HOSTS=demo.topteen.in,staging.topteen.in,localhost,127.0.0.1

# Sandbox payments on staging
RAZORPAY_ENVIRONMENT=sandbox
ICICI_EAZYPAY_ENVIRONMENT=sandbox
