# =============================================================================
# TopTeen deployment env - PRODUCTION
# Copy to production.env and fill real values:  cp production.env.example production.env
# production.env is git-ignored (never commit real secrets).
#
# This file is used two ways by deploy.sh:
#   1. --env-file for ${VAR} substitution in the compose stacks (orchestration)
#   2. env_file layered ON TOP of APP_ENV_FILE so Django gets these overrides
# =============================================================================

# --------------------------------------------------------------------------
# IDENTITY  (drives container names, image tags, network & volume names)
#   containers -> topteen-production-base-nginx-1, topteen-production-app-web-1 ...
#   images     -> developertopteen/demotopteen:production
# --------------------------------------------------------------------------
PROJECT_NAME=topteen
ENVIRONMENT=production

# --------------------------------------------------------------------------
# IMAGES  (code stack app image + base stack load-balancer image)
# --------------------------------------------------------------------------
APP_IMAGE=developertopteen/demotopteen
APP_IMAGE_TAG=production
NGINX_IMAGE=developertopteen/demotopteen-nginx
NGINX_IMAGE_TAG=production
# Optional registry push target (leave blank to skip push). deploy.sh <env> push
DOCKER_PUSH_REGISTRY=

# --------------------------------------------------------------------------
# SCALE / PERFORMANCE
# --------------------------------------------------------------------------
# Number of web (gunicorn) containers behind the load balancer
WEB_REPLICAS=3
GUNICORN_WORKERS=3
GUNICORN_THREADS=4
CELERY_CONCURRENCY=4

# --------------------------------------------------------------------------
# PUBLISHED PORTS  (load balancer). Dedicated box: 80/443.
# If the host runs other projects, pick unique ports (e.g. 8005/8443).
# --------------------------------------------------------------------------
APP_PORT=80
HTTPS_PORT=443

# Domains the load balancer answers for (space separated) -> nginx server_name
SERVER_NAMES=topteen.in www.topteen.in

# --------------------------------------------------------------------------
# BASE STACK PROFILES  (comma list; controls which infra containers run)
#   local-db = run a MariaDB container in the base stack (omit when DB is remote)
#   search   = run Elasticsearch
#   ssl      = run certbot (Let's Encrypt auto-renew)
# Production usually uses a remote/managed DB, so no local-db here.
# --------------------------------------------------------------------------
BASE_PROFILES=ssl

# --------------------------------------------------------------------------
# HOST PATHS  (bind mounts; absolute paths on the server)
# --------------------------------------------------------------------------
LOG_PATH=/home/ubuntu/topteen/logs
SSL_CERT_PATH=/home/ubuntu/topteen/ssl
CERTBOT_WEBROOT=/home/ubuntu/topteen/certbot-webroot
CERTBOT_CONF_PATH=/home/ubuntu/topteen/certbot-conf
CERTBOT_EMAIL=admin@topteen.in

# Full Django config/secrets file (SECRET_KEY, DB creds, EMAIL, payment, S3, ...).
# The overrides in the DJANGO section below are layered on top of this file.
# Path is relative to deploy/stacks/ (the compose project dir).
APP_ENV_FILE=../../.env

# =============================================================================
# DJANGO OVERRIDES FOR THIS ENVIRONMENT
# (only values that differ from the shared APP_ENV_FILE; keep secrets in APP_ENV_FILE)
# =============================================================================
DEBUG=False
DJANGO_ENVIRONMENT=production

# Redis + Elasticsearch live in the BASE stack -> reach them by service name
# over the shared network (do NOT use 127.0.0.1 here).
ENABLE_REDIS=True
REDIS_HOST=redis
REDIS_PORT=6379
ENABLE_CELERY=True
ENABLE_ELASTICSEARCH=False
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200

USE_HTTPS=True

# Database: remote/managed DB server (recommended for production).
# For a DB container instead, set DB_HOST=mariadb and add local-db to BASE_PROFILES.
DB_HOST=your-production-db-host
DB_PORT=3306

ALLOWED_HOSTS=topteen.in,www.topteen.in

# Live payments in production
RAZORPAY_ENVIRONMENT=production
ICICI_EAZYPAY_ENVIRONMENT=production
