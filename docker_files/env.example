# =============================================================================
# TopTeen docker_files deployment env
# Copy:  cp docker_files/env.example docker_files/.env  && edit values
# =============================================================================

PROJECT_NAME=topteen
ENVIRONMENT=production

APP_IMAGE=developertopteen/demotopteen
APP_IMAGE_TAG=topteen1.0
NGINX_IMAGE=developertopteen/demotopteen-nginx
NGINX_IMAGE_TAG=topteen1.0
DOCKER_PUSH_REGISTRY=

WEB_REPLICAS=2
GUNICORN_WORKERS=8
GUNICORN_THREADS=4
CELERY_CONCURRENCY=4

# Domain (no port in browser URL) — publish 80 + 443
APP_PORT=80
HTTPS_PORT=443
# IP / local testing only — alternate ports onto the same nginx
TEST_HTTP_PORT=8005
TEST_HTTPS_PORT=8443
SERVER_NAMES=test.topteen.in
# Printed in deploy URLs; also add this IP to ALLOWED_HOSTS
PUBLIC_IP=
CLIENT_MAX_BODY_SIZE=25M

# Domain HTTPS: True + redirect so http://domain → https://domain (no port)
USE_HTTPS=True
SECURE_SSL_REDIRECT=True

# Comma-separated; MUST include PUBLIC_IP if you browse by IP
ALLOWED_HOSTS=localhost,127.0.0.1,test.topteen.in
# Leave empty for IP test access (root .env often has .topteen.in)
SESSION_COOKIE_DOMAIN=
CSRF_COOKIE_DOMAIN=

# SSL: off | self-signed | letsencrypt
#   off         = HTTP only (unless certs already exist under nginx/ssl)
#   self-signed = auto-generate on ./deploy.sh up if missing
#   letsencrypt = obtain via certbot on up if missing (needs DNS + port 80)
SSL_MODE=self-signed
CERTBOT_EMAIL=admin@topteen.in

# Enable background certbot renew loop: COMPOSE_PROFILES=ssl
# (also add cron: ./docker_files/deploy.sh ssl renew)
COMPOSE_PROFILES=

# Host data root — SSL certs always live at ${DATA_ROOT}/nginx/ssl
#   (= SSL_CERT_PATH for nginx: cert.pem + key.pem)
DATA_ROOT=/data/topteens

APP_ENV_FILE=../.env

DEBUG=False
ENABLE_REDIS=True
REDIS_HOST=redis
REDIS_PORT=6379
ENABLE_CELERY=True
ENABLE_ELASTICSEARCH=False
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200
COMMON_BASE_PATH=/app/topteen1.0
