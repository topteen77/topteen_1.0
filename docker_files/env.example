# =============================================================================
# TopTeen docker_files deployment env
# Copy:  cp docker_files/env.example docker_files/.env  && edit values
#
# TWO SSL MODES
# -------------
# Option A — PRODUCTION with existing host nginx (recommended for www.topteen.in)
#   Host nginx binds :80/:443 and terminates TLS (certbot on host).
#   Docker nginx is HTTP-only on APP_PORT=8090 (8080 is taken by indo-israel).
#   Set:  APP_PORT=8090  HTTPS_PORT=8444  SSL_MODE=off  USE_HTTPS=True
#   Host must proxy to 127.0.0.1:8090 (see docker_files/nginx/production.conf).
#   Do NOT overwrite /etc/nginx/sites-enabled/topteens — enable production.conf
#   as a separate site (topteens-docker) when switching.
#
# Option B — Docker owns ports 80/443 and certs
#   Stop host nginx first. Set APP_PORT=80 HTTPS_PORT=443 SSL_MODE=letsencrypt
# =============================================================================

PROJECT_NAME=topteen
ENVIRONMENT=production

APP_IMAGE=developertopteen/demotopteen
APP_IMAGE_TAG=topteen1.0
NGINX_IMAGE=developertopteen/demotopteen-nginx
NGINX_IMAGE_TAG=topteen1.0
# Leave blank for Docker Hub. Push becomes:
#   docker push developertopteen/demotopteen:topteen1.0
#   docker push developertopteen/demotopteen-nginx:topteen1.0
# Only set DOCKER_PUSH_REGISTRY for a private/custom registry prefix.
DOCKER_PUSH_REGISTRY=
# Set PUSH_ON_SUCCESS=0 to skip Docker Hub push after successful deploy
PUSH_ON_SUCCESS=1
# COLLECTSTATIC_CLEAR=1  # wipe staticfiles before collect (noisy; leave unset for normal deploys)
# SKIP_MIGRATE=1         # never auto-migrate on deploy
# FORCE_MIGRATE=1        # always migrate (default: only when pending)
# CLEAR_CACHE=1          # clear Django/Redis cache after deploy (when required)

WEB_REPLICAS=1
GUNICORN_WORKERS=8
GUNICORN_THREADS=4
CELERY_CONCURRENCY=4

# --- Option A (host TLS) — default for production behind local nginx ----------
# APP_PORT=8090 — NOT 8080 (indo-israel-nginx already uses host :8080)
APP_PORT=8090
HTTPS_PORT=8444
TEST_HTTP_PORT=8085
TEST_HTTPS_PORT=8443
SERVER_NAMES=www.topteen.in topteen.in
PUBLIC_IP=43.204.127.118
CLIENT_MAX_BODY_SIZE=25M

USE_HTTPS=True
SECURE_SSL_REDIRECT=True

ALLOWED_HOSTS=localhost,127.0.0.1,www.topteen.in,topteen.in,43.204.127.118
SESSION_COOKIE_DOMAIN=.topteen.in
CSRF_COOKIE_DOMAIN=.topteen.in

# off = Docker HTTP only (host nginx does TLS). Do not use letsencrypt with Option A.
SSL_MODE=off
CERTBOT_EMAIL=admin@topteen.in
COMPOSE_PROFILES=

# --- Option B (Docker TLS) — uncomment AFTER stopping host nginx -------------
# APP_PORT=80
# HTTPS_PORT=443
# SSL_MODE=letsencrypt
# COMPOSE_PROFILES=ssl
# TEST_HTTP_PORT must NOT be 8005 on this host (counsel-engine uses 8005)

DATA_ROOT=/data/topteens
APP_ENV_FILE=../.env

DEBUG=False
ENABLE_REDIS=True
REDIS_HOST=redis
REDIS_PORT=6379
ENABLE_CELERY=True
ENABLE_ELASTICSEARCH=False
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200
COMMON_BASE_PATH=/app/topteen1.0

# Optional: deploy failure email recipient (uses website SES EMAIL_* from repo-root .env)
# DEPLOY_NOTIFY_TO=it@canamgroup.com
