# =============================================================================
# TopTeen docker_files — PRODUCTION (Option A)
# Host nginx owns SSL on :80/:443; Docker nginx is HTTP-only on a free port.
#
# Flow:  Internet → host nginx (TLS) → 127.0.0.1:8090 → Docker nginx → web:8000
# Host nginx for Docker: docker_files/nginx/production.conf
# Live gunicorn site /etc/nginx/sites-enabled/topteens — leave unchanged until switch.
#
# Port note: :8080 is used by indo-israel-nginx on this host — use 8090.
#
# Docker Hub (DOCKER_PUSH_REGISTRY blank):
#   docker push developertopteen/demotopteen:topteen1.0
#   docker push developertopteen/demotopteen-nginx:topteen1.0
# =============================================================================

PROJECT_NAME=topteen
ENVIRONMENT=production

APP_IMAGE=developertopteen/demotopteen
APP_IMAGE_TAG=topteen1.0
NGINX_IMAGE=developertopteen/demotopteen-nginx
NGINX_IMAGE_TAG=topteen1.0
DOCKER_PUSH_REGISTRY=
PUSH_ON_SUCCESS=1

WEB_REPLICAS=2
GUNICORN_WORKERS=3
GUNICORN_THREADS=4
CELERY_CONCURRENCY=4

# ---------------------------------------------------------------------------
# Option A ports — DO NOT use 80/443 (host nginx) or 8080 (indo-israel)
# Host nginx must proxy_pass http://127.0.0.1:8090
# ---------------------------------------------------------------------------
APP_PORT=8090
HTTPS_PORT=8444
TEST_HTTP_PORT=8085
TEST_HTTPS_PORT=8443

SERVER_NAMES=www.topteen.in topteen.in
PUBLIC_IP=43.204.127.118
CLIENT_MAX_BODY_SIZE=25M

USE_HTTPS=True
SECURE_SSL_REDIRECT=True

ALLOWED_HOSTS=localhost,127.0.0.1,www.topteen.in,topteen.in,43.204.127.118
SESSION_COOKIE_DOMAIN=.topteen.in
CSRF_COOKIE_DOMAIN=.topteen.in

# Docker does NOT terminate TLS (host nginx + host certbot do)
SSL_MODE=off
CERTBOT_EMAIL=shanti5@yopmail.com
COMPOSE_PROFILES=

DATA_ROOT=/data/topteens
APP_ENV_FILE=../.env

DEBUG=False
ENABLE_REDIS=True
REDIS_HOST=redis
REDIS_PORT=6379
ENABLE_CELERY=True
ENABLE_ELASTICSEARCH=False
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200
COMMON_BASE_PATH=/app/topteen1.0
