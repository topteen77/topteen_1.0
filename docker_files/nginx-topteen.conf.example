# Nginx Configuration for TopTeens
# This file should be placed in /data/global/conf/nginx/conf/ on the server
# Or included in your main Nginx server block

# Server block for demo.topteen.in
server {
    listen 80;
    listen [::]:80;
    server_name demo.topteen.in;

    # Increase upload size limit to allow 2MB file uploads + overhead
    # This fixes the "413 Request Entity Too Large" error
    client_max_body_size 10M;

    # Proxy settings for Django/Gunicorn
    location / {
        proxy_pass http://django:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # Increase timeouts for file uploads
        proxy_connect_timeout 300s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
    }

    # Static files
    location /static/ {
        alias /var/www/html/topteens/static/;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # Media files
    location /media/ {
        alias /var/www/html/topteens/media/;
        expires 30d;
        add_header Cache-Control "public";
    }
}

# If using HTTPS/SSL, add this to your SSL server block as well
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name demo.topteen.in;

    # SSL certificates (adjust paths as needed)
    ssl_certificate /etc/letsencrypt/live/demo.topteen.in/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/demo.topteen.in/privkey.pem;

    # Increase upload size limit to allow 2MB file uploads + overhead
    # This fixes the "413 Request Entity Too Large" error
    client_max_body_size 10M;

    # Proxy settings for Django/Gunicorn
    location / {
        proxy_pass http://django:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # Increase timeouts for file uploads
        proxy_connect_timeout 300s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
    }

    # Static files
    location /static/ {
        alias /var/www/html/topteens/static/;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # Media files
    location /media/ {
        alias /var/www/html/topteens/media/;
        expires 30d;
        add_header Cache-Control "public";
    }
}

# Alternative: Add to http block for global setting (affects all server blocks)
# http {
#     # ... other http block settings ...
#     
#     # Global upload size limit
#     client_max_body_size 10M;
#     
#     # ... rest of http block ...
# }
