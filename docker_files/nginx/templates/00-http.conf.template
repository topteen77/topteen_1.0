# HTTP (:80) — Docker nginx
# Option A: host nginx (TLS) proxies here; preserve X-Forwarded-Proto via $forwarded_proto
# default_server + `_` so IP:port access works (Host: 15.x.x.x), not only SERVER_NAMES
server {
    listen 80 default_server;
    server_name __SERVER_NAMES__ _;
    client_max_body_size __CLIENT_MAX_BODY_SIZE__;

    access_log /var/log/nginx/access.log;
    error_log  /var/log/nginx/error.log warn;

    location /.well-known/acme-challenge/ {
        root /var/www/acme;
        allow all;
    }

    location /static/ {
        alias /var/www/html/static/;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    location / {
        set $upstream "web:8000";
        proxy_pass http://$upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_connect_timeout 60s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
        proxy_next_upstream error timeout http_502 http_503 http_504;
    }
}
