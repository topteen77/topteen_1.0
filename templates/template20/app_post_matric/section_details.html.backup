{% extends 'template20/logged-in-base.html' %}

{% block title_content %}{{ section.title }} - Assessment Test | Top Teen{% endblock %}
{% block description_content %}Take the {{ section.title }} assessment test.{% endblock %}

{% block chatbot %}{% endblock %}
{% block chatbot_css %}{% endblock %}
{% block chatbot_js %}{% endblock %}
{% block footer_cta %}{% endblock %}
{% block header %}{% endblock %}
{% block footer %}{% endblock %}

{% block bodyclass %}{{ super() }} test-view-page{% endblock %}

{% block additionalhead %}
{{ super() }}
<style>
  .test-view-page {
    padding-top: 80px;
  }
  .question {
    display: none;
  }
  .question.active {
    display: block;
  }
  .question-box {
    background: #f7f7fa;
    border-radius: 10px;
    padding: 20px;
    margin-bottom: 20px;
  }
  .custom-radio {
    display: flex;
    align-items: center;
    margin-bottom: 6px;
    padding: 6px 10px;
    border: 2px solid #efefee;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.3s;
    position: relative;
  }
  .custom-radio:hover {
    border-color: #3f37c9;
    background: rgba(63, 55, 201, 0.05);
  }
  .custom-radio input[type="radio"] {
    position: absolute;
    opacity: 0;
    cursor: pointer;
    width: 0;
    height: 0;
  }
  .custom-radio .radio-checkmark {
    width: 18px;
    height: 18px;
    border: 2px solid #ddd;
    border-radius: 4px;
    margin-right: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: all 0.3s;
    background: #fff;
  }
  .custom-radio input[type="radio"]:checked ~ .radio-checkmark {
    background: #3f37c9;
    border-color: #3f37c9;
  }
  .custom-radio input[type="radio"]:checked ~ .radio-checkmark::after {
    content: '\2713';
    color: #fff;
    font-size: 12px;
    font-weight: bold;
  }
  .custom-radio input[type="radio"]:checked ~ .radio-btn {
    color: #3f37c9;
    font-weight: 600;
  }
  .custom-radio:has(input[type="radio"]:checked) {
    border-color: #3f37c9;
    background: rgba(63, 55, 201, 0.1);
  }
  .custom-radio .radio-btn {
    flex: 1;
    font-size: 14px;
    line-height: 1.4;
  }
  .test-stats-box {
    background: #f7f7fa;
    border-radius: 10px;
    padding: 20px;
    text-align: center;
  }
  .test-stats-box .stat-value {
    font-size: 24px;
    font-weight: 700;
    color: #3f37c9;
  }
  .test-stats-box .stat-label {
    font-size: 12px;
    color: #828282;
    margin-top: 5px;
  }
  .loader {
    position: relative;
    width: 100px;
    height: 100px;
    border-radius: 50%;
    margin: 20px auto;
  }
  .loader-inner {
    position: absolute;
    width: 100%;
    height: 100%;
    box-sizing: border-box;
    border-radius: 50%;
  }
  .loader-inner.box1 {
    left: 0%;
    top: 0%;
    animation: cssload-rotate-one 1.15s linear infinite;
    border-bottom: 3px solid #5C5EDC;
  }
  .loader-inner.box2 {
    right: 0%;
    top: 0%;
    animation: cssload-rotate-two 1.15s linear infinite;
    border-right: 3px solid rgba(76, 70, 101, 0.99);
  }
  .loader-inner.box3 {
    right: 0%;
    bottom: 0%;
    animation: cssload-rotate-three 1.15s linear infinite;
    border-top: 3px solid #e9908a;
  }
  @keyframes cssload-rotate-one {
    0% { transform: rotateX(35deg) rotateY(-45deg) rotateZ(0deg); }
    100% { transform: rotateX(35deg) rotateY(-45deg) rotateZ(360deg); }
  }
  @keyframes cssload-rotate-two {
    0% { transform: rotateX(50deg) rotateY(10deg) rotateZ(0deg); }
    100% { transform: rotateX(50deg) rotateY(10deg) rotateZ(360deg); }
  }
  @keyframes cssload-rotate-three {
    0% { transform: rotateX(35deg) rotateY(55deg) rotateZ(0deg); }
    100% { transform: rotateX(35deg) rotateY(55deg) rotateZ(360deg); }
  }
  .load-effect {
    background: rgba(255, 255, 255, 0.95);
    width: 100%;
    height: 100%;
    position: fixed;
    top: 0;
    bottom: 0;
    z-index: 9999;
    right: 0;
    left: 0;
    backdrop-filter: blur(3px);
    display: flex;
    justify-content: center;
    align-items: center;
    flex-direction: column;
  }
  {# Test Features CSS is included in test_features.html #}
  .introduction {
    margin: 32px 0;
    border: 1px solid #cecece;
    border-radius: 10px;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    overflow: hidden;
  }
  .instruction-content {
    height: 350px;
    overflow-y: auto;
  }
  .question-image img {
    max-width: 100%;
    height: auto;
    margin: 1rem 0;
    cursor: zoom-in;
  }
  .answer-option img {
    max-width: 100%;
    height: auto;
    margin-top: 0.5rem;
    cursor: zoom-in;
  }
  .modal-overlay {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.5);
    z-index: 1000;
    justify-content: center;
    align-items: center;
  }
  .modal-overlay.show {
    display: flex;
  }
  .modal-content {
    background-color: white;
    border-radius: 8px;
    max-width: 90%;
    padding: 20px;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
  }
  .image-modal-content {
    max-width: 90%;
    padding: 0;
    max-height: 90vh;
    display: flex;
    flex-direction: column;
  }
  .modal-image {
    max-width: 100%;
    max-height: calc(90vh - 90px);
    object-fit: contain;
  }
</style>
{% endblock %}

{% block content %}
<section class="test-view-page pb-5">
  <div class="container">
    <!-- Introduction Section -->
    <section id="introduction-section" class="introduction" style="display: block;">
      <div class="row">
        <div class="col-md-4 d-flex align-items-center bg-light">
          <div class="inimg d-md-block d-none p-4">
            <img src="{{ static('images/giant-checklist.png') }}" alt="Assessment" class="w-100 h-auto">
          </div>
        </div>
        <div class="col-md-8 inst-data py-4 px-5 bg-white">
          <h3>{{ section.title }}</h3>
          <div id="instruction-content" class="instruction-content">
            {% if section.description %}
              {{ section.description|safe }}
            {% else %}
              <p>Please complete this assessment to the best of your ability.</p>
            {% endif %}
          </div>
          <div class="bg-white pt-3">
            <button id="startBtn" class="btn btn-primary px-md-6 fw-600">Begin</button>
          </div>
        </div>
      </div>
    </section>

    <!-- Test Container -->
    <div class="question-container" style="display: none;">
      <div class="row">
        <!-- Left Sidebar (Desktop) -->
        <div class="col-lg-4 d-none d-lg-block">
          <div class="user-profile-card mb-4 sticky-top" style="top: 100px;">
            <div class="profile-header text-center">
              {% if request.user.image %}
              <img src="{{ request.user.image.url }}" alt="User Profile" class="profile-img rounded-circle mb-3" style="width: 104px; height: 104px; object-fit: cover;">
              {% else %}
              <div class="rounded-circle bg-light d-flex align-items-center justify-content-center mb-3 mx-auto" style="width: 104px; height: 104px;">
                <i class='bx bx-user fs-48 text-gray'></i>
              </div>
              {% endif %}
              <h5 class="profile-name">{{ request.user.name|default(request.user.email) }}</h5>
            </div>

            <!-- Test Stats -->
            <div class="test-stats-box mt-4">
              <div class="row g-3">
                <div class="col-6">
                  <div class="st-m-icon mb-2">
                    <i class='bx bx-time fs-32 text-purple'></i>
                  </div>
                  <p class="stat-value" id="totalTime">00:00</p>
                  <p class="stat-label">Total Time</p>
                </div>
                <div class="col-6">
                  <div class="st-m-icon mb-2">
                    <i class='bx bx-list-check fs-32 text-purple'></i>
                  </div>
                  <p class="stat-value" id="questionProgress">0/0</p>
                  <p class="stat-label">Question</p>
                </div>
              </div>
            </div>

          </div>
        </div>

        <!-- Main Content Area -->
        <div class="col-lg-8">
          <!-- Mobile Header -->
          <div class="d-lg-none d-flex justify-content-between align-items-center mb-4">
            <div class="d-flex align-items-center">
              {% if request.user.image %}
              <img src="{{ request.user.image.url }}" alt="User Profile" class="rounded-circle me-2" style="width: 50px; height: 50px; object-fit: cover;">
              {% else %}
              <div class="rounded-circle bg-light d-flex align-items-center justify-content-center me-2" style="width: 50px; height: 50px;">
                <i class='bx bx-user fs-24 text-gray'></i>
              </div>
              {% endif %}
              <div>
                <h5 class="mb-0">{{ request.user.name|default(request.user.email) }}</h5>
              </div>
            </div>
          </div>


          <!-- Mobile Test Stats -->
          <div class="d-lg-none mb-4">
            <div class="test-stats-box">
              <div class="row g-3">
                <div class="col-6">
                  <div class="st-m-icon mb-2">
                    <i class='bx bx-time fs-32 text-purple'></i>
                  </div>
                  <p class="stat-value" id="totalTimeMobile">00:00</p>
                  <p class="stat-label">Total Time</p>
                </div>
                <div class="col-6">
                  <div class="st-m-icon mb-2">
                    <i class='bx bx-list-check fs-32 text-purple'></i>
                  </div>
                  <p class="stat-value" id="questionProgressMobile">0/0</p>
                  <p class="stat-label">Question</p>
                </div>
              </div>
            </div>
          </div>

          <h2 class="fs-24 fw-semibold mb-3" id="section-title">{{ section.title }}</h2>
          
          <div class="alert alert-info d-flex align-items-center mb-4">
            <i class='bx bx-info-circle me-2 fs-20'></i>
            <div class="fs-14">Select the most effective option from the choices provided based on the given statement</div>
          </div>

          <div class="alert alert-danger" id="error-message" style="display: none;">
            <i class='bx bx-error-circle me-2'></i> Please select an answer before proceeding.
          </div>

          <div id="questions-container" class="questions-container">
            <div class="loading text-center py-5">
              <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
              </div>
              <p class="mt-3">Loading questions...</p>
            </div>
          </div>

          <div class="navigation-buttons d-flex justify-content-end gap-3 mt-4">
            <button id="prev-question" class="btn btn-secondary" style="display: none;">Previous</button>
            <button id="next-question" class="btn btn-primary">Next</button>
            <button id="submit-section" class="btn btn-success" style="display: none;">Submit Section</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Loading Overlay -->
<div id="loader" class="load-effect" style="display: none;">
  <div class="loader">
    <div class="loader-inner box1"></div>
    <div class="loader-inner box2"></div>
    <div class="loader-inner box3"></div>
  </div>
  <p class="mt-3">
    <img src="{{ static('images_new/logos/topteen-logo.svg') }}" style="height: 45px;" alt="TopTeen">
  </p>
</div>

<!-- Submit Confirmation Modal -->
<div id="submitConfirmationModal" class="modal-overlay">
  <div class="modal-content">
    <div class="modal-title">Submit Section</div>
    <div class="modal-message">
      Are you sure you want to submit this section? You won't be able to change your answers after submission.
    </div>
    <div class="modal-actions">
      <button id="submitCancelBtn" class="btn btn-secondary">Cancel</button>
      <button id="submitConfirmBtn" class="btn btn-success">Submit</button>
    </div>
  </div>
</div>

<!-- Image Modal -->
<div id="imageModal" class="modal-overlay">
  <div class="modal-content image-modal-content">
    <div class="modal-header d-flex justify-content-between align-items-center p-3 border-bottom">
      <div class="modal-title">Image Preview</div>
      <button id="closeImageModalBtn" class="btn-close"></button>
    </div>
    <div class="modal-image-container p-3">
      <img id="modalImage" src="" alt="Question Image" class="modal-image">
    </div>
  </div>
</div>
{% endblock %}

{% block additionaljs %}
{{ super() }}
<!-- jQuery -->
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<!-- SweetAlert2 -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
$(document).ready(function() {
  const sectionId = {{ section_id }};
  const testId = {{ test_id }};
  const sessionId = {{ session_id }};
  const timeLimit = {{ time_limit }} * 60; // Convert to seconds

  let questions = [];
  let currentQuestionIndex = 0;
  let timer = null;
  let startTime = null;
  let questionStartTimes = {};
  let answerTimes = [];
  const MIN_TIME_PER_QUESTION = 3; // Minimum 3 seconds per question
  let userAnswers = {};
  let currentSession = sessionId;
  // Initialize section session from context
  let currentSectionSession = {% if section_session %}{ id: {{ section_session.id }}, session: {{ section_session.session.id }}, section: {{ section_session.section.id }} }{% else %}null{% endif %};

  // Get CSRF token
  function getCookie(name) {
    let cookieValue = null;
    if (document.cookie && document.cookie !== '') {
      const cookies = document.cookie.split(';');
      for (let i = 0; i < cookies.length; i++) {
        const cookie = cookies[i].trim();
        if (cookie.startsWith(name + '=')) {
          cookieValue = decodeURIComponent(cookie.substring(name.length + 1));
          break;
        }
      }
    }
    return cookieValue;
  }

  // Timer functionality
  function startTimer(seconds) {
    startTime = Date.now();
    const timerDisplay = $('#totalTime, #totalTimeMobile');
    let timeLeft = seconds;

    timer = setInterval(function() {
      const minutes = Math.floor(timeLeft / 60);
      const secs = timeLeft % 60;
      const timeString = `${minutes.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
      timerDisplay.text(timeString);

      if (timeLeft === 0) {
        clearInterval(timer);
        submitSection();
      }
      timeLeft--;
    }, 1000);
  }


  // Load questions
  async function loadQuestions() {
    try {
      const headers = {
        'Content-Type': 'application/json',
        'X-CSRFToken': getCookie('csrftoken'),
        'Accept': 'application/json'
      };

      // Load questions
      const questionsUrl = `/api/questions/?section=${sectionId}`;
      const questionsRes = await fetch(questionsUrl, {
        headers: headers,
        credentials: 'same-origin'
      });

      if (!questionsRes.ok) {
        throw new Error('Failed to load questions');
      }

      const data = await questionsRes.json();
      questions = Array.isArray(data) ? data : (data.results || []);

      // Fetch answers for each question
      for (let question of questions) {
        const answersUrl = `/api/answers/?question=${question.id}`;
        const answersRes = await fetch(answersUrl, {
          headers: headers,
          credentials: 'same-origin'
        });

        if (answersRes.ok) {
          const answersData = await answersRes.json();
          question.answers = answersData.results || answersData;
        }
      }

      questions.sort((a, b) => a.order - b.order);
      
      if (questions.length === 0) {
        $('#questions-container').html('<div class="alert alert-info">No questions available for this section.</div>');
        return;
      }

      renderCurrentQuestion();
      updateProgress();
      
      // Start timer if time limit is set
      if (timeLimit > 0) {
        startTimer(timeLimit);
      }

      // Initialize timing for first question
      questionStartTimes[0] = Date.now();

    } catch (error) {
      console.error('Error loading questions:', error);
      $('#questions-container').html('<div class="alert alert-danger">Failed to load questions. Please try refreshing the page.</div>');
    }
  }

  // Render current question
  function renderCurrentQuestion() {
    const question = questions[currentQuestionIndex];
    if (!question) return;

    const questionHtml = `
      <div class="question-box">
        <div class="question-header mb-3">
          <h4 class="fs-18 fw-semibold">
            <span class="text-purple me-2">Question ${currentQuestionIndex + 1}:</span>
            ${question.text}
          </h4>
        </div>
        ${question.image ? `<div class="question-image mb-3"><img src="${question.image}" alt="Question Image" class="img-fluid" onclick="openImageModal('${question.image}')" style="cursor: zoom-in;"></div>` : ''}
        <div class="answers-container">
          ${question.answers ? question.answers.map((answer, idx) => `
            <label class="custom-radio" for="answer-${question.id}-${answer.id}">
              <input type="radio" name="question-${question.id}" id="answer-${question.id}-${answer.id}" value="${answer.id}" data-score="${answer.score || 0}" data-category="${answer.category || ''}" data-is-correct="${answer.is_correct || false}">
              <span class="radio-checkmark"></span>
              <span class="radio-btn">${answer.text}</span>
              ${answer.image ? `<img src="${answer.image}" alt="Answer Image" class="mt-2" onclick="event.stopPropagation(); openImageModal('${answer.image}');" style="cursor: zoom-in; max-width: 100%;">` : ''}
            </label>
          `).join('') : '<p>No answers available</p>'}
        </div>
      </div>
    `;

    $('#questions-container').html(questionHtml);

    // Restore previously selected answer if exists
    const questionKey = `Question_${question.order}`;
    if (userAnswers[questionKey]) {
      const savedAnswerId = userAnswers[questionKey].answer_id;
      $(`input[value="${savedAnswerId}"]`).prop('checked', true);
    }

    // Set question start time
    questionStartTimes[currentQuestionIndex] = Date.now();

    updateNavigationButtons();
  }

  // Save current answer
  function saveCurrentAnswer() {
    const question = questions[currentQuestionIndex];
    if (!question) return;
    
    const selectedInput = $(`input[name="question-${question.id}"]:checked`);
    
    if (selectedInput.length > 0) {
      const answerId = parseInt(selectedInput.val());
      const answer = question.answers.find(a => a.id === answerId);
      
      userAnswers[`Question_${question.order}`] = {
        question_id: question.id,
        answer_id: answerId,
        selected_answer: answer ? answer.text : '',
        correct_answer: answer && answer.is_correct ? answer.text : null,
        score: parseInt(selectedInput.data('score')) || 0,
        category: selectedInput.data('category') || null
      };
    } else {
      delete userAnswers[`Question_${question.order}`];
    }
  }

  // Update progress
  function updateProgress() {
    const progressText = `${currentQuestionIndex + 1} / ${questions.length}`;
    $('#questionProgress, #questionProgressMobile').text(progressText);
  }

  // Update navigation buttons
  function updateNavigationButtons() {
    $('#prev-question').toggle(currentQuestionIndex > 0);
    $('#next-question').toggle(currentQuestionIndex < questions.length - 1);
    $('#submit-section').toggle(currentQuestionIndex === questions.length - 1);
  }

  // Submit section
  async function submitSection() {
    try {
      // Save current answer
      saveCurrentAnswer();

      // Check if all questions are answered
      const unansweredQuestions = [];
      for (let i = 0; i < questions.length; i++) {
        const questionKey = `Question_${questions[i].order}`;
        if (!userAnswers[questionKey]) {
          unansweredQuestions.push(i + 1);
        }
      }

      if (unansweredQuestions.length > 0) {
        Swal.fire({
          title: 'Incomplete',
          text: `Please answer questions: ${unansweredQuestions.join(', ')}`,
          icon: 'warning',
          confirmButtonText: 'OK'
        });
        return;
      }

      // Check if session and section session exist
      if (!currentSession || !currentSectionSession) {
        throw new Error('No active session found');
      }

      // Calculate score
      let score = 0;
      let totalQuestions = questions.length;
      let categoryCounts = {};
      Object.values(userAnswers).forEach(answer => {
        if (answer.category) {
          categoryCounts[answer.category] = (categoryCounts[answer.category] || 0) + 1;
        }
        score += answer.score;
      });

      // Update section session end time before submitting
      if (currentSectionSession && currentSectionSession.id) {
        try {
          const updateResponse = await fetch(`/api/section-sessions/${currentSectionSession.id}/`, {
            method: 'PATCH',
            headers: {
              'Content-Type': 'application/json',
              'X-CSRFToken': getCookie('csrftoken')
            },
            body: JSON.stringify({
              end_time: new Date().toISOString(),
              is_completed: true
            })
          });
          
          if (!updateResponse.ok) {
            console.error('[ERROR] Failed to update section session end time:', await updateResponse.json());
          } else {
            console.log('[DEBUG] Successfully updated section session end time');
          }
        } catch (err) {
          console.error('[ERROR] Error updating section session end time:', err);
        }
      }

      // Save responses first
      await fetch(`/api/responses/${currentSession}/save_responses/`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRFToken': getCookie('csrftoken')
        },
        body: JSON.stringify({
          submitted_answers: userAnswers,
          category_counts: categoryCounts,
          score: score,
          total_questions: totalQuestions,
          section_session: currentSectionSession.id
        })
      });

      // Then submit the session
      const resultRes = await fetch(`/api/sessions/${currentSession}/submit/`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRFToken': getCookie('csrftoken')
        }
      });

      if (!resultRes.ok) {
        const errorData = await resultRes.json().catch(() => ({}));
        throw new Error(errorData.detail || errorData.error || 'Failed to submit test');
      }

      const result = await resultRes.json();

      // Redirect to sections list (matching old template behavior)
      window.location.href = `/api/web/test/${testId}/sections/`;
    } catch (error) {
      console.error('Error submitting section:', error);
      const errorMessage = error.message || 'Failed to submit section. Please try again.';
      Swal.fire({
        title: 'Submission Error',
        text: errorMessage,
        icon: 'error',
        confirmButtonText: 'OK'
      });
      $('#submitBtn').prop('disabled', false).text('Submit Section');
    }
  }

  // Event listeners
  $('#startBtn').on('click', function() {
    $('#introduction-section').hide();
    $('.question-container').show();
    loadQuestions();
  });

  $('#prev-question').on('click', function() {
    if (currentQuestionIndex > 0) {
      saveCurrentAnswer();
      currentQuestionIndex--;
      renderCurrentQuestion();
      updateProgress();
      questionStartTimes[currentQuestionIndex] = Date.now();
    }
  });

  $('#next-question').on('click', function() {
    const question = questions[currentQuestionIndex];
    const selectedInput = $(`input[name="question-${question.id}"]:checked`);
    
    if (selectedInput.length === 0) {
      $('#error-message').show();
      setTimeout(() => $('#error-message').hide(), 3000);
      return;
    }

    saveCurrentAnswer();
    
    if (questionStartTimes[currentQuestionIndex]) {
      const timeSpent = (Date.now() - questionStartTimes[currentQuestionIndex]) / 1000;
      answerTimes.push(timeSpent);
    }

    if (currentQuestionIndex < questions.length - 1) {
      currentQuestionIndex++;
      renderCurrentQuestion();
      updateProgress();
      questionStartTimes[currentQuestionIndex] = Date.now();
    }
  });

  $('#submit-section').on('click', function() {
    const question = questions[currentQuestionIndex];
    const selectedInput = $(`input[name="question-${question.id}"]:checked`);
    
    if (selectedInput.length === 0) {
      $('#error-message').show();
      setTimeout(() => $('#error-message').hide(), 3000);
      return;
    }

    $('#submitConfirmationModal').addClass('show');
  });

  $('#submitConfirmBtn').on('click', function() {
    $('#submitConfirmationModal').removeClass('show');
    submitSection();
  });

  $('#submitCancelBtn').on('click', function() {
    $('#submitConfirmationModal').removeClass('show');
  });

  // Image modal
  window.openImageModal = function(imageSrc) {
    $('#modalImage').attr('src', imageSrc);
    $('#imageModal').addClass('show');
  };

  $('#closeImageModalBtn, #imageModal').on('click', function(e) {
    if (e.target === this || $(e.target).hasClass('modal-overlay')) {
      $('#imageModal').removeClass('show');
    }
  });

});
</script>

{% endblock %}

