# Production server block (server_name from .env: PRODUCTION_SERVER_NAMES)
# HTTPS is in topteen-ssl.conf (enabled by entrypoint when SSL certs exist)
server {
    listen 80;
    server_name ${PRODUCTION_SERVER_NAMES};
    client_max_body_size 10M;
    access_log /var/log/nginx/access.log;
    error_log /var/log/nginx/error.log warn;

    # Let's Encrypt ACME challenge (certbot renew --webroot)
    location /.well-known/acme-challenge/ {
        root /var/www/acme;
        allow all;
    }

    location /static/ {
        alias /var/www/html/static/;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    location /media/ {
        alias /var/www/html/media/;
        expires 30d;
        add_header Cache-Control "public";
    }

    location / {
        proxy_pass http://django;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 300s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
    }
}
